{
  "name": "edtech-node-api",
  "version": "1.0.0",
  "description": "Node.js + Express REST API backend for EdTech Platform (JavaScript)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "prisma:generate": "prisma generate --schema=../../database/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=../../database/prisma/schema.prisma",
    "prisma:seed": "node ../../database/prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^5.10.0"
  }
}
